# =============================================================================
# Expense App — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git.
# =============================================================================

# ----- Server -----
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ----- Database (MySQL) -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_app
DB_USER=root
DB_PASSWORD=changeme

# ----- JWT -----
# Generate a strong secret: `openssl rand -base64 64`
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ----- Razorpay -----
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
PREMIUM_AMOUNT_PAISE=50000
PREMIUM_CURRENCY=INR

# ----- Email (transactional) -----
# Driver: 'smtp' (any SMTP server) or 'console' (logs to stdout — for local dev)
EMAIL_DRIVER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Expense App <noreply@expense.app>"

# Public URL the password reset link points to (frontend route)
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ----- File Storage -----
# 'local' for dev (writes to ./uploads), 's3' for prod
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=./uploads

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- Logging -----
LOG_LEVEL=info
